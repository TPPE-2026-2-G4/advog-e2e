# AMBIENTE DE TESTE: local/produção
E2E_AMBIENTE=local

# URL DO FRONTEND
URL_LOCAL=http://localhost:3000
URL_PRODUCAO=

# URL DO BACKEND (OPCIONAL)
API_URL_LOCAL=http://localhost:8000
API_URL_PRODUCAO=

# EMAIL E SENHA DO USUÁRIO DE TESTE
EMAIL_LOCAL=
SENHA_LOCAL=
EMAIL_PRODUCAO=
SENHA_PRODUCAO=

# RITMO DE EXECUÇÃO DOS TESTES (em segundos)
# 0 = sem pausa (rápido, para CI). 1.5 a 3 = bom para apresentar.
E2E_DELAY=1.5
# Pausa (em segundos) entre cada letra digitada. 0 = digita tudo de uma vez.
E2E_DELAY_DIGITACAO=0.05
# Destaca com uma borda colorida o elemento que o teste vai usar (true/false)
E2E_DESTACAR=true
# true = sem abrir a janela do navegador (use em CI); false = você vê o navegador
E2E_HEADLESS=false

# LIMITES E SEGURANÇA
E2E_TIMEOUT=20
E2E_TIMEOUT_PRODUCAO=60
# Testes que criam/apagam dados (marcados com "escrita") só rodam em produção se for true
E2E_PERMITIR_ESCRITA_PRODUCAO=false
# true = a tour FALHA se alguma página do menu não aparecer para o usuário de teste
E2E_EXIGIR_TODAS_AS_PAGINAS=true
